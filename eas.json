{
  "cli": {
    "version": ">= 18.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "node": "22.23.2",
      "env": {
        "EXPORT_METHOD": "ad-hoc",
        "CAP_SERVER_URL": "http://192.168.1.127:5173"
      },
      "ios": {
        "scheme": "App",
        "buildConfiguration": "Release",
        "config": "ios.yml",
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.23.2",
      "env": {
        "EXPORT_METHOD": "ad-hoc"
      },
      "ios": {
        "scheme": "App",
        "buildConfiguration": "Release",
        "config": "ios.yml",
        "image": "latest"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "node": "22.23.2",
      "env": {
        "EXPORT_METHOD": "app-store"
      },
      "ios": {
        "scheme": "App",
        "buildConfiguration": "Release",
        "config": "ios.yml",
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
